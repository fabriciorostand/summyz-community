#!/bin/sh
set -eu
umask 077
repository_path=$(CDPATH= cd -- "${1:?Repository directory is required}" && pwd)
for dependency in curl udevadm sha256sum awk getconf; do
  command -v "$dependency" >/dev/null 2>&1 || { echo "Hardware agent dependency is missing: $dependency" >&2; exit 1; }
done
read_setting() {
  awk -v name="$1" '
    /^[[:space:]]*#/ {next}
    {
      separator=index($0,"="); if (!separator) next
      key=substr($0,1,separator-1); gsub(/^[[:space:]]+|[[:space:]]+$/,"",key)
      if (key!=name) next
      value=substr($0,separator+1); gsub(/^[[:space:]]+|[[:space:]\r]+$/,"",value)
      quote=substr(value,1,1)
      if ((quote=="\"" || quote=="\047") && substr(value,length(value),1)==quote) value=substr(value,2,length(value)-2)
      print value; exit
    }' "$repository_path/.env"
}
json_string() {
  awk 'BEGIN {printf "\""} {
    if (NR>1) printf "\\n"
    for (i=1;i<=length($0);i++) {
      c=substr($0,i,1)
      if (c=="\\" || c=="\"") printf "\\%s",c
      else if (c=="\t") printf "\\t"
      else if (c=="\r") printf "\\r"
      else printf "%s",c
    }
  } END {printf "\""}'
}
temporary_path=$(mktemp -d)
monitor_pid=""
cleanup() {
  if [ -n "$monitor_pid" ]; then kill "$monitor_pid" 2>/dev/null || true; wait "$monitor_pid" 2>/dev/null || true; fi
  rm -f "$temporary_path/events" "$temporary_path/report.json" "$temporary_path/request.conf"
  rmdir "$temporary_path"
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP
key=$(read_setting SUMMYZ_SECRETS_KEY)
[ -n "$key" ] || { echo "The installation secrets key is missing" >&2; exit 1; }
token=$(printf 'summyz-hardware/v1:%s' "$key" | sha256sum | awk '{print $1}')
host_address=$(read_setting WEB_HOST)
case "$host_address" in ::) host_address=::1 ;;
  ""|0.0.0.0|localhost) host_address=127.0.0.1 ;; esac
case "$host_address" in *[!0-9a-fA-F.:]*) echo "WEB_HOST must be an IP address for the hardware agent" >&2; exit 1 ;; esac
case "$host_address" in *:*) host_address="[$host_address]" ;; esac
port=$(read_setting WEB_PORT)
port=${port:-8787}
case "$port" in *[!0-9]*|"") echo "Invalid dashboard port" >&2; exit 1 ;; esac
[ "$port" -ge 1 ] && [ "$port" -le 65535 ] || { echo "Invalid dashboard port" >&2; exit 1; }
origin=$(read_setting PUBLIC_BASE_URL)
origin=${origin:-http://127.0.0.1:$port}
case "$origin" in *\"*|*\\*) echo "Invalid dashboard origin" >&2; exit 1 ;; esac
printf 'header = "x-summyz-hardware-token: %s"\nheader = "Origin: %s"\nheader = "Host: 127.0.0.1:%s"\n' "$token" "$origin" "$port" > "$temporary_path/request.conf"

collect_snapshot() {
  memory=$(awk '/^MemTotal:/ {printf "%.0f", $2*1024}' /proc/meminfo)
  cpu_name=$(awk -F ': ' '/^model name/ {print $2; exit}' /proc/cpuinfo)
  cpu_name=${cpu_name:-CPU}
  {
    printf '{"platform":"linux","detectedAt":"%s","hardware":{"cpuCores":%s,"memoryBytes":%s,"cpuName":' "$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)" "$(getconf _NPROCESSORS_ONLN)" "$memory"
    printf '%s' "$cpu_name" | json_string
    printf ',"accelerators":['
    separator=""
    if command -v nvidia-smi >/dev/null 2>&1; then
      nvidia_json=$(nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader,nounits 2>/dev/null |
        awk -F ',' '
          function escape(value) {gsub(/\\/,"\\\\",value); gsub(/"/,"\\\"",value); return value}
          NF==3 {
            for(i=1;i<=3;i++) gsub(/^[[:space:]]+|[[:space:]]+$/,"",$i)
            if($1 !~ /^[0-9]+$/ || $3 !~ /^[0-9]+$/) next
            printf "%s{\"id\":\"nvidia-%s\",\"vendor\":\"nvidia\",\"name\":\"%s\"",separator,$1,escape($2)
            if($3>0) printf ",\"memoryBytes\":%.0f",$3*1024*1024
            printf "}"; separator=","
          }' || true)
      if [ -n "$nvidia_json" ]; then printf '%s' "$nvidia_json"; separator=","; fi
    fi
    for vendor_path in /sys/class/drm/card[0-9]*/device/vendor; do
      [ -f "$vendor_path" ] || continue
      [ "$(cat "$vendor_path")" = "0x1002" ] || continue
      printf '%s{"id":' "$separator"
      printf '%s' "$vendor_path" | json_string
      printf ',"vendor":"amd","name":"AMD GPU"'
      memory_path="$(dirname "$vendor_path")/mem_info_vram_total"
      if [ -r "$memory_path" ]; then
        vram=$(cat "$memory_path")
        case "$vram" in *[!0-9]*|"") ;; *) [ "$vram" -eq 0 ] || printf ',"memoryBytes":%s' "$vram" ;; esac
      fi
      printf '}'
      separator=","
    done
    printf ']}}\n'
  } > "$temporary_path/report.json"
}
deliver_snapshot() {
  # A retry repeats only HTTP delivery, never hardware enumeration.
  until curl --silent --show-error --fail --max-time 10 --output /dev/null --config "$temporary_path/request.conf" --header "Content-Type: application/json" --data-binary "@$temporary_path/report.json" "http://$host_address:$port/api/internal/hardware"; do
    printf '{"event":"hardware_report_failed","reason":"dashboard_unreachable"}\n' >&2
    sleep 5
  done
}
mkfifo "$temporary_path/events"
udevadm monitor --udev --subsystem-match=pci --subsystem-match=drm --subsystem-match=cpu --subsystem-match=memory > "$temporary_path/events" &
monitor_pid=$!
# Open the pipe before enumeration so events occurring during startup stay queued.
exec 3< "$temporary_path/events"
collect_snapshot
deliver_snapshot
while IFS= read -r event <&3; do
  case "$event" in
    UDEV*' add '*|UDEV*' remove '*|UDEV*' change '*|UDEV*' bind '*|UDEV*' unbind '*|UDEV*' online '*|UDEV*' offline '*)
      collect_snapshot
      deliver_snapshot
      ;;
  esac
done
echo "The native hardware event monitor stopped" >&2
exit 1
