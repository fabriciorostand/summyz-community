# - - - Infraestrutura do dashboard - - -
# Os launchers geram esta chave automaticamente no primeiro uso.
SUMMYZ_SECRETS_KEY=
# Credencial interna de setup, também gerada automaticamente. Não a compartilhe.
SUMMYZ_SETUP_TOKEN=
# O launcher público define public no Compose; local é o padrão seguro.
DASHBOARD_ACCESS_MODE=local
# O padrão aceita conexões somente desta máquina.
WEB_HOST=127.0.0.1
WEB_PORT=8787
# Origem do dashboard. Em uma VPS, informe a origem HTTPS pública.
PUBLIC_BASE_URL=http://127.0.0.1:8787

# - - - Armazenamento operacional - - -
DATA_DIR=./data
# Idioma, retenção de conteúdo (ativa por padrão), retenção de áudio (desativada por padrão),
# credenciais do Discord e OpenRouter são configuradas pelo dashboard por servidor/instalação.
# Opcional: registra comandos imediatamente apenas no servidor de desenvolvimento indicado.
DISCORD_GUILD_ID=

# - - - PostgreSQL - - -
# Use postgres as the host with Docker Compose and localhost when running the bot through npm.
DATABASE_URL=
POSTGRES_DB=summyz-community-db
POSTGRES_USER=summyz_community
POSTGRES_PASSWORD=
# Exposed only on 127.0.0.1 by Compose; change it if port 5432 is already in use.
POSTGRES_PORT=5433

# - - - Logging - - -
LOG_LEVEL=info

# - - - Local execution - - -
# Desenvolvimento nativo: caminho absoluto opcional; sem ele, usa ffmpeg/ffmpeg.exe do PATH.
# No Docker, um build LGPL controlado do FFmpeg é instalado automaticamente.
# FFMPEG_PATH=C:\\ffmpeg\\bin\\ffmpeg.exe
# auto detecta o hardware mais potente; GPU incompatível exige fallback cpu explícito.
# gpu exige aceleração; cpu nunca concede nem usa GPU.
LOCAL_AI_DEVICE=auto
# none interrompe se a GPU selecionada falhar; cpu autoriza fallback explícito.
# Quando LOCAL_AI_DEVICE=cpu, qualquer valor aqui tem efeito de none.
LOCAL_AI_FALLBACK=none

# Provedores, modelos, idiomas, chunks e geração pertencem aos perfis salvos no PostgreSQL.

# - - - Recording - - -
SEGMENT_SILENCE_MS=1000
SEGMENT_MAX_SECONDS=60
VOICE_RECONNECT_MAX_MS=300000

# - - - Transcription - - -
TRANSCRIPTION_CONCURRENCY=2
TRANSCRIPTION_WINDOW_MAX_SECONDS=30
TRANSCRIPTION_MAX_ATTEMPTS=4
TRANSCRIPTION_TIMEOUT_MS=90000
TRANSCRIPTION_RETRY_BASE_MS=1000
TRANSCRIPTION_RETRY_MAX_MS=30000

# - - - Refinement - - -
REFINEMENT_MAX_ATTEMPTS=3
REFINEMENT_TIMEOUT_MS=120000
REFINEMENT_RETRY_BASE_MS=1000
REFINEMENT_RETRY_MAX_MS=30000

# - - - Summary - - -
SUMMARY_MAX_ATTEMPTS=4
SUMMARY_TIMEOUT_MS=120000
SUMMARY_RETRY_BASE_MS=1000
SUMMARY_RETRY_MAX_MS=30000
SUMMARY_TIME_ZONE=America/Sao_Paulo
