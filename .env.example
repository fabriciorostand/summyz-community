DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Opcional: registra comandos imediatamente apenas no servidor de desenvolvimento.
DISCORD_GUILD_ID=
# local não inicia nem exige banco; postgres exige DATABASE_URL antes de conectar ao Discord.

STORAGE_MODE=local
# Use postgres como host no Docker Compose e localhost ao executar o bot pelo npm.
# DATABASE_URL=postgresql://summyz:troque-esta-senha@postgres:5432/summyz
POSTGRES_DB=summyz
POSTGRES_USER=summyz
POSTGRES_PASSWORD=troque-esta-senha
# Porta publicada apenas em 127.0.0.1 pelo Compose; altere se 5432 estiver ocupada.
POSTGRES_PORT=5432
# As três opções abaixo são capturadas no início e não mudam uma reunião em andamento.
# true preserva transcrições, resumo e estados finais no backend escolhido.
PERSIST_MEETING_CONTENT=false
# true preserva os arquivos de áudio no DATA_DIR e cataloga seus caminhos no backend escolhido.
PERSIST_MEETING_AUDIO=false
DATA_DIR=./data

LOG_LEVEL=info

OPENROUTER_API_KEY=
OPENROUTER_TRANSCRIPTION_MODEL=
OPENROUTER_REFINEMENT_MODEL=google/gemini-3.7-flash
OPENROUTER_SUMMARY_MODEL=google/gemini-3.7-flash
TRANSCRIPTION_MODEL_PROFILES_FILE=./config/transcription-model-profiles.json
SEGMENT_SILENCE_MS=1000
SEGMENT_MAX_SECONDS=60
VOICE_RECONNECT_MAX_MS=300000
TRANSCRIPTION_CONCURRENCY=2
TRANSCRIPTION_VAD_THRESHOLD=0.5
TRANSCRIPTION_VAD_MIN_SPEECH_MS=96
TRANSCRIPTION_MERGE_MAX_GAP_MS=2000
TRANSCRIPTION_WINDOW_MAX_SECONDS=30
TRANSCRIPTION_MAX_ATTEMPTS=4
TRANSCRIPTION_TIMEOUT_MS=90000
TRANSCRIPTION_RETRY_BASE_MS=1000
TRANSCRIPTION_RETRY_MAX_MS=30000
REFINEMENT_CHUNK_MAX_CHARACTERS=500000
REFINEMENT_MAX_ATTEMPTS=3
REFINEMENT_TIMEOUT_MS=120000
REFINEMENT_RETRY_BASE_MS=1000
REFINEMENT_RETRY_MAX_MS=30000
SUMMARY_CHUNK_MAX_CHARACTERS=500000
SUMMARY_MAX_ATTEMPTS=4
SUMMARY_TIMEOUT_MS=120000
SUMMARY_RETRY_BASE_MS=1000
SUMMARY_RETRY_MAX_MS=30000
SUMMARY_TIME_ZONE=America/Sao_Paulo
