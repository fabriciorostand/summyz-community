# - - - Discord - - -
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: registers commands immediately in the development server only.
DISCORD_GUILD_ID=
# Language for fixed Discord messages and command descriptions: en or pt-br. Default: en.
BOT_LANGUAGE=en

# - - - Storage and persistence - - -
# These three settings are captured when a meeting starts and do not change while it is in progress.
# local neither starts nor requires a database; postgres requires DATABASE_URL.
STORAGE_MODE=local
DATA_DIR=./data
# true preserves transcripts, the summary, and final states in the selected backend.
PERSIST_MEETING_CONTENT=false
# true preserves audio files in DATA_DIR and catalogs their paths in the selected backend.
PERSIST_MEETING_AUDIO=false

# - - - PostgreSQL - - -
# Use postgres as the host with Docker Compose and localhost when running the bot through npm.
# DATABASE_URL=postgresql://summyz:troque-esta-senha@postgres:5432/summyz
POSTGRES_DB=summyz
POSTGRES_USER=summyz
POSTGRES_PASSWORD=troque-esta-senha
# Exposed only on 127.0.0.1 by Compose; change it if port 5432 is already in use.
POSTGRES_PORT=5432

# - - - Logging - - -
LOG_LEVEL=info

# - - - Providers and models - - -
# Cada fase pode usar OpenRouter ou o provedor local correspondente de forma independente.
# O Compose mantém Ollama e faster-whisper numa rede privada, sem publicar portas no host.
TRANSCRIPTION_PROVIDER=openrouter
REFINEMENT_PROVIDER=openrouter
SUMMARY_PROVIDER=openrouter

# auto detecta o idioma na transcrição e escreve o resumo no idioma predominante da reunião.
# Informe um código BCP 47, como en, es ou pt-BR, para fixar um idioma.
TRANSCRIPTION_LANGUAGE=auto
SUMMARY_LANGUAGE=auto

# Em auto, o Summyz analisa o hardware e escolhe o melhor modelo geral multilíngue que couber.
# Usuários experientes podem informar um modelo exato.
FASTER_WHISPER_MODEL=auto
OLLAMA_REFINEMENT_MODEL=auto
OLLAMA_SUMMARY_MODEL=auto

# Necessário somente quando pelo menos uma fase usa OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_TRANSCRIPTION_MODEL=
OPENROUTER_REFINEMENT_MODEL=google/gemini-3.7-flash
OPENROUTER_SUMMARY_MODEL=google/gemini-3.7-flash

# - - - Recording - - -
SEGMENT_SILENCE_MS=1000
SEGMENT_MAX_SECONDS=60
VOICE_RECONNECT_MAX_MS=300000

# - - - Transcription - - -
TRANSCRIPTION_MODEL_PROFILES_FILE=./config/transcription-model-profiles.json
TRANSCRIPTION_CONCURRENCY=2
TRANSCRIPTION_VAD_THRESHOLD=0.5
TRANSCRIPTION_VAD_MIN_SPEECH_MS=96
TRANSCRIPTION_MERGE_MAX_GAP_MS=2000
TRANSCRIPTION_WINDOW_MAX_SECONDS=30
TRANSCRIPTION_MAX_ATTEMPTS=4
TRANSCRIPTION_TIMEOUT_MS=90000
TRANSCRIPTION_RETRY_BASE_MS=1000
TRANSCRIPTION_RETRY_MAX_MS=30000

# - - - Refinement - - -
REFINEMENT_CHUNK_MAX_CHARACTERS=500000
REFINEMENT_MAX_ATTEMPTS=3
REFINEMENT_TIMEOUT_MS=120000
REFINEMENT_RETRY_BASE_MS=1000
REFINEMENT_RETRY_MAX_MS=30000

# - - - Summary - - -
SUMMARY_CHUNK_MAX_CHARACTERS=500000
SUMMARY_MAX_ATTEMPTS=4
SUMMARY_TIMEOUT_MS=120000
SUMMARY_RETRY_BASE_MS=1000
SUMMARY_RETRY_MAX_MS=30000
SUMMARY_TIME_ZONE=America/Sao_Paulo
