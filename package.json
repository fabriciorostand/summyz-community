{
  "name": "summyz-community",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "workspaces": [
    "web"
  ],
  "description": "Bot para Discord que grava calls, transcreve participantes e publica resumos.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "npm run build --workspace web",
    "benchmark:transcription": "tsx scripts/benchmark-transcription.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:web && npm run test:python && npm run test:coverage && npm run test:web",
    "cla:sign": "node scripts/cla/create-signature.mjs",
    "dev": "tsx --env-file=.env src/main.ts",
    "dev:api": "tsx --env-file=.env src/api/main.ts",
    "dev:web": "npm run dev --workspace web",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "security:audit": "npm audit --omit=optional",
    "start": "node dist/main.js",
    "start:api": "node dist/api/main.js",
    "test": "vitest run",
    "test:python": "python -m unittest discover -s services/faster-whisper -p \"test_*.py\"",
    "test:coverage": "vitest run --coverage",
    "test:web": "npm test --workspace web",
    "test:smoke:local-ai": "vitest run --config vitest.smoke.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "npm run typecheck --workspace web"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@node-rs/argon2": "^2.1.0",
    "avr-vad": "1.0.10",
    "discord.js": "14.27.0",
    "fastify": "^5.12.1",
    "jose": "^6.2.10",
    "nodemailer": "^9.0.5",
    "opusscript": "0.0.8",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "prism-media": "1.3.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.10",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  }
}
