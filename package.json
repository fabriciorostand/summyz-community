{
  "name": "summyz-community",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "workspaces": [
    "packages/shared",
    "apps/bot",
    "apps/api",
    "apps/dashboard"
  ],
  "description": "Bot para Discord que grava calls, transcreve participantes e publica resumos.",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:dashboard",
    "build:server": "tsc -b tsconfig.build.json",
    "build:shared": "npm run build --workspace packages/shared",
    "build:bot": "npm run build --workspace apps/bot",
    "build:api": "npm run build --workspace apps/api",
    "build:dashboard": "npm run build --workspace apps/dashboard",
    "dev": "node --env-file=.env --conditions=development --import tsx apps/bot/src/main.ts",
    "dev:api:local": "node --env-file=.env --conditions=development --import tsx apps/api/src/main.ts --access-mode local",
    "dev:api:public": "node --env-file=.env --conditions=development --import tsx apps/api/src/main.ts --access-mode public",
    "dev:dashboard": "npm run dev --workspace apps/dashboard",
    "start": "node apps/bot/dist/main.js",
    "api:local": "node apps/api/dist/main.js --access-mode local",
    "api:public": "node apps/api/dist/main.js --access-mode public",
    "check": "npm run check:biome && npm run typecheck && npm run test:coverage",
    "check:biome": "biome check .",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit",
    "typecheck:dashboard": "npm run typecheck --workspace apps/dashboard",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "npm run test:workspaces && npm run test:root && npm run test:python",
    "test:workspaces": "npm run test --workspaces",
    "test:root": "vitest run",
    "test:shared": "npm run test --workspace packages/shared",
    "test:bot": "npm run test --workspace apps/bot",
    "test:api": "npm run test --workspace apps/api",
    "test:dashboard": "npm run test --workspace apps/dashboard",
    "test:integration": "vitest run tests/integration",
    "test:repository": "vitest run tests/repository",
    "test:python": "python -m unittest discover -s services/faster-whisper -p \"test_*.py\"",
    "test:watch": "vitest --config vitest.server.config.ts",
    "test:smoke:local-ai": "vitest run --config vitest.smoke.config.ts",
    "test:coverage": "vitest run --config vitest.server.config.ts --coverage && npm run test:dashboard:coverage && npm run test:python",
    "test:coverage:workspaces": "npm run test:coverage --workspaces",
    "test:coverage:ci": "vitest run --config vitest.ci.config.ts --coverage",
    "test:dashboard:coverage": "npm run test:coverage --workspace apps/dashboard",
    "test:python:coverage": "python -m pytest services/faster-whisper --cov=services/faster-whisper --cov-branch --cov-report=term-missing --cov-report=xml:artifacts/reports/python/coverage.xml --cov-report=html:artifacts/reports/python/coverage --junitxml=artifacts/reports/python/junit.xml",
    "benchmark:transcription": "node --conditions=development --import tsx scripts/benchmark-transcription.ts",
    "eval:summary": "node --env-file-if-exists=.env --conditions=development --import tsx scripts/evaluate-summary.ts",
    "cla:sign": "node scripts/cla/create-signature.mjs",
    "release:sbom": "node scripts/release/generate-sbom.mjs",
    "security:audit": "npm audit --omit=optional",
    "prepare": "node scripts/install-husky.mjs"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@babel/types": "7.29.8",
    "@biomejs/biome": "2.5.8",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "husky": "9.1.7",
    "jscpd": "5.1.2",
    "lint-staged": "16.4.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "overrides": {
    "adm-zip": "0.6.1"
  }
}
