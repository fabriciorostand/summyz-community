{
  "name": "summyz-community-api",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b tsconfig.build.json && tsc --noEmit",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "dev:local": "cd ../.. && node --env-file=.env --conditions=development --import tsx apps/api/src/main.ts --access-mode local",
    "start:local": "cd ../.. && node apps/api/dist/main.js --access-mode local",
    "dev:public": "cd ../.. && node --env-file=.env --conditions=development --import tsx apps/api/src/main.ts --access-mode public",
    "start:public": "cd ../.. && node apps/api/dist/main.js --access-mode public"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@node-rs/argon2": "2.0.2",
    "fastify": "^5.12.1",
    "pino": "10.3.1",
    "summyz-community-shared": "1.0.0",
    "zod": "4.4.3"
  }
}
