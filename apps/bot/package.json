{
  "name": "summyz-community-bot",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b tsconfig.build.json && tsc --noEmit",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "dev": "cd ../.. && node --env-file=.env --conditions=development --import tsx apps/bot/src/main.ts",
    "start": "cd ../.. && node apps/bot/dist/main.js"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "avr-vad": "1.0.10",
    "discord.js": "14.27.0",
    "franc": "6.2.0",
    "opusscript": "0.0.8",
    "pino": "10.3.1",
    "prism-media": "1.3.5",
    "summyz-community-shared": "1.0.0",
    "zod": "4.4.3"
  }
}
