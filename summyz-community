#!/bin/sh

set -eu

if [ "$(uname -s)" != Linux ]; then
  echo "Summyz supports only Windows and Linux. Use this launcher on Linux or the PowerShell launcher on Windows." >&2
  exit 1
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_dir=$script_dir
cd "$repository_dir"

command_name=${1:-}
if [ -z "$command_name" ]; then
  echo "Usage: ./summyz-community <up|down|restart|status|logs|recover-access> [--dry-run]" >&2
  exit 2
fi
shift

dry_run=false
if [ "${1:-}" = "--dry-run" ]; then
  dry_run=true
  shift
fi
if [ "$#" -ne 0 ]; then
  echo "Unexpected launcher arguments" >&2
  exit 2
fi

read_env_setting() {
  setting_name=$1
  if [ ! -f .env ]; then
    return
  fi
  awk -v wanted="$setting_name" '
    /^[[:space:]]*#/ { next }
    {
      key = $0
      sub(/=.*/, "", key)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
      if (key == wanted) {
        value = $0
        sub(/^[^=]*=/, "", value)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
        if (value ~ /^".*"$/ || value ~ /^\047.*\047$/) {
          value = substr(value, 2, length(value) - 2)
        }
        print value
        exit
      }
    }
  ' .env
}

generate_secret() {
  dd if=/dev/urandom bs=32 count=1 2>/dev/null | base64 | tr '/+' '_-' | tr -d '=\r\n'
}

replace_env_setting() {
  setting_name=$1
  setting_value=$2
  awk -v wanted="$setting_name" -v replacement="$setting_value" '
    BEGIN { replaced = 0 }
    {
      key = $0
      sub(/=.*/, "", key)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
      if (key == wanted) {
        print wanted "=" replacement
        replaced = 1
      } else {
        print
      }
    }
    END { if (!replaced) print wanted "=" replacement }
  ' .env > .env.tmp
  mv .env.tmp .env
}

initialize_dot_env() {
  # Secrets created by this function must never inherit a permissive umask.
  umask 077
  if [ ! -f .env ]; then
    if [ ! -f .env.example ]; then
      echo ".env.example is missing" >&2
      exit 1
    fi
    cp .env.example .env
    database_password=$(generate_secret)
    replace_env_setting SUMMYZ_SECRETS_KEY "$(generate_secret)"
    replace_env_setting SUMMYZ_SETUP_TOKEN "$(generate_secret)"
    replace_env_setting POSTGRES_PASSWORD "$database_password"
    replace_env_setting DATABASE_URL "postgresql://summyz_community:$database_password@postgres:5432/summyz-community-db"
    echo "Created .env with random local secrets. Keep this file private."
  fi
  chmod 600 .env

  password=$(read_env_setting POSTGRES_PASSWORD)
  database_url=$(read_env_setting DATABASE_URL)
  secrets_key=$(read_env_setting SUMMYZ_SECRETS_KEY)
  setup_token=$(read_env_setting SUMMYZ_SETUP_TOKEN)
  case "$(printf '%s' "$password" | tr '[:upper:]' '[:lower:]')" in
    ""|troque-esta-senha|change-me|changeme)
      echo "POSTGRES_PASSWORD must contain a non-placeholder value in .env" >&2
      exit 1
      ;;
  esac
  case "$(printf '%s' "$database_url" | tr '[:upper:]' '[:lower:]')" in
    ""|*troque-esta-senha*|*change-me*|*changeme*)
      echo "DATABASE_URL must contain a non-placeholder PostgreSQL password in .env" >&2
      exit 1
      ;;
  esac
  if [ -z "$secrets_key" ]; then
    echo "SUMMYZ_SECRETS_KEY must be set in .env" >&2
    exit 1
  fi
  if [ -z "$setup_token" ]; then
    echo "SUMMYZ_SETUP_TOKEN must be set in .env" >&2
    exit 1
  fi
}

if [ "$command_name" = "up" ] || [ "$command_name" = "restart" ]; then
  initialize_dot_env
fi

profile=cpu
gpu_name=""

use_cpu_only() {
  echo "Warning: $1; GPU unavailable, CPU instances remain available" >&2
  profile=cpu
  gpu_name=""
}

detect_acceleration() {
  injected_vendor=${SUMMYZ_DETECTED_GPU_VENDOR:-}
  if [ -n "$injected_vendor" ]; then
    case "$injected_vendor" in
      nvidia)
        profile=nvidia
        gpu_name=${SUMMYZ_DETECTED_GPU_NAME:-NVIDIA GPU}
        return
        ;;
      amd)
        profile=amd
        gpu_name=${SUMMYZ_DETECTED_GPU_NAME:-AMD GPU}
        return
        ;;
      *)
        use_cpu_only "GPU vendor $injected_vendor has no supported Docker profile"
        return
        ;;
    esac
  fi

  if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia_output=$(nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader,nounits 2>/dev/null || true)
    if [ -n "$nvidia_output" ]; then
      first_gpu=$(printf '%s\n' "$nvidia_output" | sed -n '1p')
      gpu_name=$(printf '%s' "$first_gpu" | cut -d, -f2 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
      memory_mib=$(printf '%s' "$first_gpu" | cut -d, -f3 | sed 's/[^0-9]//g')
      profile=nvidia
      export SUMMYZ_DETECTED_GPU_VENDOR=nvidia
      export SUMMYZ_DETECTED_GPU_NAME="$gpu_name"
      if [ -n "$memory_mib" ]; then
        SUMMYZ_DETECTED_GPU_MEMORY_BYTES=$((memory_mib * 1024 * 1024))
        export SUMMYZ_DETECTED_GPU_MEMORY_BYTES
      fi
      return
    fi
  fi

  amd_detected=false
  for vendor_file in /sys/class/drm/card*/device/vendor; do
    [ -f "$vendor_file" ] || continue
    vendor=$(tr '[:upper:]' '[:lower:]' < "$vendor_file")
    if [ "$vendor" = "0x1002" ]; then
      amd_detected=true
      break
    fi
  done
  if [ "$amd_detected" = true ]; then
    if [ ! -e /dev/kfd ] || [ ! -d /dev/dri ]; then
      use_cpu_only "AMD GPU detected without accessible ROCm devices /dev/kfd and /dev/dri"
      return
    fi
    profile=amd
    gpu_name="AMD GPU"
    export SUMMYZ_DETECTED_GPU_VENDOR=amd
    export SUMMYZ_DETECTED_GPU_NAME="$gpu_name"
    return
  fi

}

print_selection() {
  case "$profile" in
    nvidia) echo "GPU: $gpu_name"; echo "Profile: NVIDIA/CUDA" ;;
    amd) echo "GPU: $gpu_name"; echo "Profile: AMD/ROCm" ;;
    *) echo "Profile: CPU" ;;
  esac
}

run_compose() {
  if [ "$profile" = "nvidia" ]; then
    if [ "${SUMMYZ_PUBLIC_MODE:-false}" = "true" ]; then
      set -- -f compose.yaml -f docker/compose.nvidia.yaml -f docker/compose.public.yaml "$@"
    else
      set -- -f compose.yaml -f docker/compose.nvidia.yaml "$@"
    fi
  elif [ "$profile" = "amd" ]; then
    if [ "${SUMMYZ_PUBLIC_MODE:-false}" = "true" ]; then
      set -- -f compose.yaml -f docker/compose.amd.yaml -f docker/compose.public.yaml "$@"
    else
      set -- -f compose.yaml -f docker/compose.amd.yaml "$@"
    fi
  else
    if [ "${SUMMYZ_PUBLIC_MODE:-false}" = "true" ]; then
      set -- -f compose.yaml -f docker/compose.public.yaml "$@"
    else
      set -- -f compose.yaml "$@"
    fi
  fi

  printf 'Executing: docker compose'
  for argument in "$@"; do
    printf ' %s' "$argument"
  done
  printf '\n'

  if [ "$dry_run" = true ]; then
    return
  fi
  if ! command -v docker >/dev/null 2>&1; then
    echo "Docker is not installed or is unavailable in PATH" >&2
    return 1
  fi
  if ! docker info >/dev/null 2>&1; then
    echo "Docker daemon is unavailable" >&2
    return 1
  fi
  docker compose "$@"
}

start_gpu_services() {
  [ "$profile" != cpu ] || return 0
  gpu_services=ollama-gpu
  if [ "$profile" = nvidia ]; then gpu_services="$gpu_services faster-whisper-gpu"; fi
  for gpu_service in $gpu_services; do
    if ! run_compose up -d --build --no-deps --wait --wait-timeout 90 "$gpu_service"; then
      echo "Warning: $gpu_service failed to start; this provider's GPU is unavailable, CPU remains available" >&2
      run_compose stop "$gpu_service" || echo "Warning: Unable to stop unavailable GPU service" >&2
      run_compose rm -f "$gpu_service" || echo "Warning: Unable to remove unavailable GPU service" >&2
    fi
  done
}

show_setup_page() {
  setup_token=$(read_env_setting SUMMYZ_SETUP_TOKEN)
  [ -n "$setup_token" ] || return
  public_base_url=$(read_env_setting PUBLIC_BASE_URL)
  web_port=$(read_env_setting WEB_PORT)
  web_port=${web_port:-8787}
  if [ -n "$public_base_url" ]; then
    base_url=${public_base_url%/}
  else
    base_url="http://127.0.0.1:$web_port"
  fi
  setup_url="$base_url/setup#claim=$setup_token"
  if [ "${SUMMYZ_PUBLIC_MODE:-false}" = "true" ]; then
    echo "Open the private setup link shown below. It stops working after setup is completed."
    echo "$setup_url"
  elif command -v xdg-open >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    xdg-open "$setup_url" >/dev/null 2>&1 || echo "$setup_url"
  else
    echo "$setup_url"
  fi
}

case "$command_name" in
  up)
    detect_acceleration
    print_selection
    run_compose up -d --build
    start_gpu_services
    if [ "$dry_run" = false ]; then show_setup_page; fi
    ;;
  restart)
    detect_acceleration
    print_selection
    run_compose up -d --build --force-recreate
    start_gpu_services
    ;;
  down)
    run_compose down --remove-orphans
    ;;
  status) run_compose ps ;;
  logs) run_compose logs --follow ;;
  recover-access) run_compose exec dashboard node dist/api/installation-access-recovery.js --access-mode public ;;
  *)
    echo "Usage: ./summyz-community <up|down|restart|status|logs|recover-access> [--dry-run]" >&2
    exit 2
    ;;
esac
